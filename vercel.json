{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/catalog",
      "destination": "/artisanal",
      "permanent": true
    },
    {
      "source": "/catalog-files/:path*",
      "destination": "/artisanal",
      "permanent": true
    },
    {
      "source": "/store",
      "destination": "/shop",
      "permanent": true
    }
  ]
}